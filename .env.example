# Copy this file to ".env" for local work. NEVER commit ".env" (it is listed in
# .gitignore). On Vercel, add the same names under
#   Project -> Settings -> Environment Variables
# instead of using a file.
#
# Where each value comes from is explained in docs/BACKEND_SETUP.md.

# ---- Needed by the server functions (api/*) — set on Vercel AND locally ------

# Supabase: Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Cloudinary: Dashboard -> top-left "Cloud name", and Settings -> API Keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=keep-this-secret-never-put-it-in-the-website-or-in-chat

# ---- Needed ONLY by the bulk-upload script (tools/bulk-upload.mjs) -----------
# Run it on your own computer. Do NOT add this to Vercel and do NOT put it in
# assets/config.js: the service-role key can read and write everything.
SUPABASE_SERVICE_ROLE_KEY=
